generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique
  phone         String?        @unique
  passwordHash  String
  role          String         @default("CUSTOMER") // CUSTOMER | ADMIN
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  notifications Notification[]
}

model PlatformSettings {
  id                String   @id @default(cuid())
  payoutAccountNo   String   @default("4521212")
  payoutAccountName String   @default("الصادق حمد الصادق اسماعيل")
  payoutBankName    String   @default("بنك الخرطوم - Bankak")
  dollarRate        Float    @default(2500.0)
  shippingPerKg     Float    @default(15000.0)
  customsFee        Float    @default(5000.0)
  profitMargin      Float    @default(0.15)
  updatedAt         DateTime @updatedAt
}

model Order {
  id                  String   @id @default(cuid())
  orderNumber         String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUrl          String
  productTitle        String
  productSpecs        String?
  quantity            Int      @default(1)
  priceUsd            Float
  weightKg            Float    @default(0.5)
  dollarRateSnapshot  Float
  shippingCostSdg     Float
  customsFeeSdg       Float
  profitMarginSdg     Float
  totalSdg            Float
  actualShippingSdg   Float?
  actualCustomsSdg    Float?
  deliveryAddress     String
  deliveryPhone       String
  paymentMethod       String   @default("BANKAK") // BANKAK | SYBERPAY
  receiptUrl          String?
  status              String   @default("PENDING_REVIEW") // PENDING_REVIEW | PAYMENT_APPROVED | PAYMENT_REJECTED | PURCHASED | IN_WAREHOUSE | IN_TRANSIT | IN_CUSTOMS | READY_FOR_DELIVERY | DELIVERED
  rejectionReason     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CuratedProduct {
  id                String   @id @default(cuid())
  title             String
  store             String   // Amazon | Shein | AliExpress | Noon
  url               String
  priceUsd          Float
  estimatedWeightKg Float    @default(0.5)
  category          String   @default("عام")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  details   String
  createdAt DateTime @default(now())
}
